# Lotka-Volterra predictions
data=pd.read_csv(f'./Lotka-Volterra/noise_data/0.1_0.csv')
with open(f'./Lotka-Volterra/results/exh_ode_mdl0.1_0.pkl', 'rb') as f:
    # A new file will be created
    bms_ode=pd.read_pickle(f)


with open(f'./Lotka-Volterra/results/exh_fit_mdl_0.1_0.pkl', 'rb') as f:
    # A new file will be created
    bms_fit=pd.read_pickle(f)


with open(f'./Lotka-Volterra/results/exh_smooth_mdl_0.1_0.pkl', 'rb') as f:
    # A new file will be created
    bms_smooth=pd.read_pickle(f)


ode_pred=bms_ode['x'].predict({'A0':data})
fit_pred=bms_fit['x'].predict({'A0':data})
smooth_pred=bms_smooth['x'].predict({'A0':data})

###############################################################################################
data_lv_train=pd.read_csv(f'./Lotka-Volterra/noise_data/0.1_0.csv')
#X = np.stack((data_lv_train['x'].values, data_lv_train['y'].values), axis=-1)
#time=data_lv_train['t'].values
X = data_lv_train[['x', 'y']].to_numpy().reshape((len(data_lv_train.x), 2))
time = data_lv_train.t.to_numpy().reshape((len(data_lv_train.x), 1))    
print('Length lotka data',len(time))
# Weak sindy
n_models=1000
library_functions = [lambda x: x, lambda x: x * x, lambda x, y: x * y,
                     lambda x, y: x * x * y,lambda x, y: x * y * y,lambda x: x * x * x]
library_function_names = [lambda x: x,lambda x: x+x,lambda x, y: x+y,
                     lambda x, y: x+x+y,lambda x, y: x + y + y,lambda x: x + x + x]
feature_names = ['x','y']
ensemble_optimizer = ps.STLSQ(threshold=1e-3)

weak_lib = ps.WeakPDELibrary(
    library_functions=library_functions,
    function_names=library_function_names,
    include_bias=True,
    spatiotemporal_grid=data_lv_train.t.to_numpy(),
    is_uniform=True,
    K=1000,
)

# SINDy initialization
model = ps.SINDy(
    feature_names=feature_names,
    feature_library=weak_lib,
    optimizer=ensemble_optimizer,
)
model.fit(
    X,
    ensemble=True,
    n_models=n_models,
    quiet=True
)
model.print()
print(model.coefficients())
print(model.get_feature_names())
ensemble_coefs = np.asarray(model.coef_list)
print(np.median(ensemble_coefs, axis=0))
def poly(_x,_y,coefs):
    return np.sum([coefs[0], coefs[1]*_x, coefs[2]*_y, coefs[3]*_x*_x, coefs[4]*_y*_y, coefs[5]*_x*_y,
                   coefs[6]*_x*_x*_y, coefs[7]*_x*_y*_y,coefs[8]*_x*_x*_x,coefs[9]*_y*_y*_y])
wsindy_pred_x=[poly(i.x,i.y,model.coefficients()[0]) for i in data.itertuples()]
wsindy_pred_y=[poly(i.x,i.y,model.coefficients()[1]) for i in data.itertuples()]
ground_truth_x=[poly(i.x,i.y,[0.,0.1,.0,.0,.0,-0.02,.0,.0,.0,.0]) for i in data.itertuples()]
ground_truth_y=[poly(i.x,i.y,[0.,.0,-0.4,.0,.0,0.02,.0,.0,.0,.0]) for i in data.itertuples()]
#####################################################################################################
#Regurar sindy
n_models=1000
ensemble_optimizer = ps.STLSQ(threshold=1e-3)
poly_library = ps.PolynomialLibrary(degree=3, include_bias=True)
model = ps.SINDy(
    feature_names=['x','y'],
    feature_library=poly_library,
    optimizer=ensemble_optimizer,
)
dt=data_lv_train.t[1]-data_lv_train.t[0]
model.fit(X, t=dt, ensemble=True, n_models=n_models, quiet=True)
model.print()
print(model.coefficients())
print(model.get_feature_names())
ensemble_coefs = np.asarray(model.coef_list)
print(np.median(ensemble_coefs, axis=0))
def poly(_x,_y,coefs):
    return np.sum([coefs[0], coefs[1]*_x, coefs[2]*_y, coefs[3]*_x*_x, coefs[4]*_x*_y, coefs[5]*_y*_y,
                   coefs[6]*_x*_x*_x, coefs[7]*_x*_x*_y,coefs[8]*_x*_y*_y,coefs[9]*_y*_y*_y])
rsindy_pred_x=[poly(i.x,i.y,model.coefficients()[0]) for i in data.itertuples()]
rsindy_pred_y=[poly(i.x,i.y,model.coefficients()[1]) for i in data.itertuples()]

axs1=fig1.add_subplot(gs_lotka_low[0])
axs1.plot(data.x, wsindy_pred_x, c=colors['WS'],lw=0.75)
axs1.plot(data.x, rsindy_pred_x, c=colors['RS'],lw=0.75)
axs1.plot(data.x, smooth_pred['A0'].to_numpy(), c=colors['SD-BMS'],lw=0.75)
axs1.plot(data.x, fit_pred['A0'].to_numpy(), c=colors['FD-BMS'],lw=0.75)
axs1.plot(data.x, ode_pred['A0'].to_numpy(), c=colors['I-BMS'],lw=0.75)
axs1.plot(data.x, ground_truth_x, '-.',lw=0.5,c=colors['gt'])
axs1.set_xlabel(r'$\dot{x}$')

#axs0[1].legend(loc='best',frameon=False,fontsize=10)
axs1.tick_params(axis='both', which='major')
#axs1.yaxis.set_tick_params(labelleft=False)

ode_pred=bms_ode['y'].predict({'A0':pd.DataFrame(data={'x':data.y,'y':data.x})})
