#Logistic Low noise:
with open(f'./Logistic/noise_data_res_exhaustive_new/BMS_0.005_0.pkl', 'rb') as f:
    # A new file will be created
    bms_ode=pickle.load(f)
with open(f'./Logistic/noise_data_res_exhaustive_new/BMS_fit_0.005_0.pkl', 'rb') as f:
    # A new file will be created
    bms_fit=pickle.load(f)
with open(f'./Logistic/noise_data_res_exhaustive_new/BMS_smooth_0.005_0.pkl', 'rb') as f:
    # A new file will be created
    bms_smooth=pickle.load(f)
x=np.linspace(0,1,20)

ode_pred = bms_ode.predict({'A0':pd.DataFrame(data={'B':x})})
fit_pred = bms_fit.predict({'A0':pd.DataFrame(data={'B':x})})
smooth_pred = bms_smooth.predict({'A0':pd.DataFrame(data={'B':x})})

# Weak Sindy
data=pd.read_pickle(f'./Logistic/noise_data/0.005_0.pkl')
X = data['B'].values
time=data['t'].values
print('Length logistic data',len(time))
###############################################################################################
# Weak sindy
n_models=1000
library_functions = [lambda x: x, lambda x: x * x, lambda x: x * x * x, lambda x: x * x * x * x]
library_function_names = [lambda x: x,lambda x: x+x, lambda x: x + x + x, lambda x: x + x + x + x]
feature_names = ['B']
ensemble_optimizer = ps.STLSQ()
weak_lib = ps.WeakPDELibrary(
    library_functions=library_functions,
    function_names=library_function_names,
    include_bias=True,
    spatiotemporal_grid=data.t.to_numpy(),
    is_uniform=True,
    K=1000,
)
# SINDy initialization
model = ps.SINDy(
    feature_names=feature_names,
    feature_library=weak_lib,
    optimizer=ensemble_optimizer,
)
model.fit(
    X,
    ensemble=True,
    n_models=n_models,
    quiet=True
)
model.print()
def poly(_x,coefs):
    return coefs[0]+np.sum([coefs[i]*_x**i for i in range(1,len(coefs))])
wsindy_pred=[poly(i,model.coefficients()[0]) for i in x]
print(wsindy_pred)
print(len(X),np.shape(wsindy_pred),len(x))
#####################################################################################################
#Regurar sindy
n_models=1000
ensemble_optimizer = ps.STLSQ()
poly_library = ps.PolynomialLibrary(degree=4, include_bias=True)
model = ps.SINDy(
    feature_names=['B'],
    feature_library=poly_library,
    optimizer=ensemble_optimizer,
)
dt=data.t[1]-data.t[0]
model.fit(X, t=dt, ensemble=True, n_models=n_models, quiet=True)
rsindy_pred=[poly(i,model.coefficients()[0]) for i in x]

ground_truth=[poly(i,[0,1,-1,0]) for i in x]
axs1=fig1.add_subplot(gs[0,0])
axs1.plot(x, wsindy_pred, c=colors['WS'],lw=0.75)
axs1.plot(x, rsindy_pred, c=colors['RS'],lw=0.75)
axs1.plot(x, smooth_pred['A0'].to_numpy(), c=colors['SD-BMS'],lw=0.75)
axs1.plot(x, fit_pred['A0'].to_numpy(), c=colors['FD-BMS'],lw=0.75)
axs1.plot(x, ode_pred['A0'].to_numpy(), c=colors['I-BMS'],lw=0.75)
axs1.plot(x, ground_truth, '-.',lw=0.5,c=colors['gt'])
axs1.set_xlabel(r'$\dot{x}$')
axs1.set_ylabel(None)
#axs0[1].legend(loc='best',frameon=False,fontsize=10)
axs1.tick_params(axis='both', which='major')
#axs1.yaxis.set_tick_params(labelleft=False)

