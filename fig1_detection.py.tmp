axs1.plot(data.x, fit_pred['A0'].to_numpy(), c=colors['FD-BMS'],lw=0.75)
axs1.plot(data.x, ode_pred['A0'].to_numpy(), c=colors['I-BMS'],lw=0.75)
axs1.plot(data.x, ground_truth_x,'-.',lw=0.5,c=colors['gt'])
axs1.set_xlabel(r'$\dot{x}$')

#axs0[1].legend(loc='best',frameon=False,fontsize=10)
#axs1.tick_params(axis='both', which='major')
#axs1.yaxis.set_tick_params(labelleft=False)

ode_pred=bms_ode['y'].predict({'A0':pd.DataFrame(data={'x':data.y,'y':data.x})})
fit_pred=bms_fit['y'].predict({'A0':data})
smooth_pred=bms_smooth['y'].predict({'A0':data})
axs1=fig1.add_subplot(gs_lotka_high[1])
axs1.plot(data.y, wsindy_pred_y, c=colors['WS'],label='W-ESINDY',lw=0.75)
axs1.plot(data.y, rsindy_pred_y, c=colors['RS'],label='ESINDY',lw=0.75)
axs1.plot(data.y, smooth_pred['A0'].to_numpy(), c=colors['SD-BMS'],label='SD-BMS',lw=0.75)
axs1.plot(data.y, fit_pred['A0'].to_numpy(), c=colors['FD-BMS'],label='FD-BMS',lw=0.75)
axs1.plot(data.y, ode_pred['A0'].to_numpy(), c=colors['I-BMS'],label='I-BMS',lw=0.75)
axs1.plot(data.y, ground_truth_y, '-.',lw=0.5,c=colors['gt'],label='ground truth')
handles,labels = axs1.get_legend_handles_labels()
axs1.set_xlabel(r'$\dot{x}$')
axs1.set_ylabel(None)
#axs0[1].legend(loc='best',frameon=False,fontsize=10)
#axs1.tick_params(axis='both', which='major')
#axs1.yaxis.set_tick_params(labelleft=False)
